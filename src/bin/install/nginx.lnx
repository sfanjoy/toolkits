#!/usr/bin/env bash
set -euo pipefail

dnf -y install nginx
setsebool -P httpd_can_network_connect 1
openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout /etc/nginx/nginx-selfsigned.key -out /etc/nginx/nginx-selfsigned.crt
TDAY=`date "+%Y%m%d-%s"`
mv -f /etc/nginx/nginx.conf /etc/nginx/nginx.conf.$TDAY
install -m 0644 /root/config/etc/nginx/nginx.conf.$2 /etc/nginx/nginx.conf
mkdir -p /etc/nginx/sites-enabled
mkdir -p /etc/nginx/sites-available
install -m 0644 /root/config/etc/nginx/sites-available/localnotion_log.$2 /etc/nginx/sites-available/localnotion_log
install -m 0644 /root/config/etc/nginx/sites-available/localnotion_api.$2 /etc/nginx/sites-available/localnotion_api
install -m 0644 /root/config/etc/nginx/sites-available/localnotion_app.$2 /etc/nginx/sites-available/localnotion_app
install -m 0644 /root/config/etc/nginx/sites-available/localnotion_webhooks.$2 /etc/nginx/sites-available/localnotion_webhooks
systemctl enable --now nginx
systemctl start nginx
systemctl status nginx --no-pager

